# Cronometer CLI automatic re-login credentials — TEMPLATE.
#
# To enable self-healing (see DURABILITY.md), copy this file to:
#     ~/.config/cronometer-cli/credentials
# fill in the two values, then lock it down:
#     chmod 600 ~/.config/cronometer-cli/credentials
#
# crono.py REFUSES to read the file unless its permissions are exactly
# 0600. The password is passed only to the Cronometer login call — it is
# never printed, logged, or stored anywhere else. Never commit the real
# file to git.
email=you@example.com
password=your-cronometer-password
